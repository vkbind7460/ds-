<!DOCTYPE html>
<html>
<head>
    <title>Online Book Store</title>

    <style>
        body {
            margin: 0;
            font-family: Arial;
        }

        .frame {
            height: 30vh;
            border: 1px solid black;
            margin: 5px;
            padding: 10px;
        }

        h1, h2 {
            color: darkblue;
        }

        .home {
            background-color: lightblue;
            text-align: center;
        }

        .login {
            background-color: lightyellow;
            text-align: center;
        }

        .catalogue {
            background-color: lightgreen;
            text-align: center;
        }

        input {
            padding: 5px;
            margin: 5px;
        }

        table {
            margin: auto;
            border-collapse: collapse;
            width: 70%;
        }

        th, td {
            border: 1px solid black;
            padding: 8px;
        }

        th {
            background-color: green;
            color: white;
        }
    </style>
</head>

<body>

    <!-- Home Page -->
    <div class="frame home">
        <h1>Online Book Store</h1>
        <p>Welcome to our Online Book Store</p>
        <p>Find your favourite books at one place.</p>
    </div>


    <!-- Login Page -->
    <div class="frame login">
        <h2>Login Page</h2>

        <form>
            Username:
            <input type="text">
            <br>

            Password:
            <input type="password">
            <br>

            <input type="submit" value="Login">
        </form>
    </div>


    <!-- Catalogue Page -->
    <div class="frame catalogue">
        <h2>Book Catalogue</h2>

        <table>
            <tr>
                <th>Book Name</th>
                <th>Author</th>
                <th>Price</th>
            </tr>

            <tr>
                <td>HTML Basics</td>
                <td>John Smith</td>
                <td>Rs. 250</td>
            </tr>

            <tr>
                <td>CSS Guide</td>
                <td>David Lee</td>
                <td>Rs. 300</td>
            </tr>

            <tr>
                <td>JavaScript Basics</td>
                <td>James Brown</td>
                <td>Rs. 350</td>
            </tr>
        </table>
    </div>

</body>
</html>
